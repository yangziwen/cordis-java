<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cordis</groupId>
    <artifactId>cordis-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>cordis-java</name>
    <description>cordis（TypeScript 依赖注入/插件框架）核心部分的 Java 改写范例</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- SQLite JDBC 驱动 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.21.0.1</version>
        </dependency>

        <!--
            OkHttp 3.14.x 是最后一个纯 Java 实现的大版本（4.x 起改用 Kotlin 编写，
            会连带引入 kotlin-stdlib）。本项目只依赖它的 enqueue 异步回调，
            不需要 4.x 的 Kotlin API。
        -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>3.14.9</version>
        </dependency>

        <!--
            Jackson 只用于 wire 层（cordis.agent.llm）：把 OpenAI 兼容协议的
            JSON 与流式分片读成 JsonNode，框架内核与 agent 包本身仍然不依赖它。
            2.17.x 是 Java 8 基线，不需要 3.x（要求 JDK 17）。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>

        <!--
            Playwright（无头浏览器）：只给 cordis.browser 能力层用，内核与 agent
            包不依赖它。1.65.1 官方要求 Java 8+，主 pom 仍是 source/target 8。

            代价必须知道：
            - driver-bundle 这个 jar 有 229MB（内含 node 与 playwright driver），
              会拖慢构建与镜像，别把它打进 fat jar；
            - 首次运行会下载浏览器二进制（chromium ~192MB + headless shell ~101MB）。
              生产镜像要预装并设 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1，否则启动时会
              联网下载（而且是全部浏览器，不只是 chromium）。
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.65.1</version>
        </dependency>
    </dependencies>
</project>
